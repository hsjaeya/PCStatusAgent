<Window x:Class="PCStatusAgent.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Status - 로그인" Height="317" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PC Status Agent" FontSize="20"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="이메일" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="EmailBox" Margin="0,0,0,10" Height="30" Padding="5"/>

        <TextBlock Grid.Row="3" Text="비밀번호" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="4" x:Name="PasswordBox" Margin="0,0,0,20" Height="30" Padding="5"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="LoginBtn" Content="로그인" Width="100" Height="35"
                    Margin="0,0,10,0" Click="LoginBtn_Click"/>
            <Button x:Name="RegisterBtn" Content="회원가입" Width="100" Height="35"
                    Click="RegisterBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>